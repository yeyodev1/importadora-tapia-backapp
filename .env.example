DB_URI=mongodb://localhost:27017/your-database
PORT=8100
JWT_SECRET=your_secret_key
SLACK_ERROR_WEBHOOK=

# Orígenes CORS extra de producción, separados por coma
CORS_ORIGINS=

# Clave opcional para GET /api/health/mysql?key=...
HEALTH_KEY=

# MySQL ERP (Importadora Tapia) — vía Cloudflare Tunnel, requiere SSL/TLS
# Con MYSQL_TUNNEL_HOSTNAME definido se lanza/reutiliza `cloudflared access tcp`
# local; MYSQL_HOST/MYSQL_PORT sólo se usan si no hay túnel (red interna).
MYSQL_TUNNEL_HOSTNAME=mysql-crm.bakano.ec
MYSQL_TUNNEL_LOCAL_PORT=13306
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=dbimcatabe
MYSQL_USER=crm_user
MYSQL_PASSWORD=
# CA pública del ERP: PEM crudo, PEM en base64, o ruta a archivo
MYSQL_SSL_CA=
MYSQL_SSL_CA_PATH=./certs/ca.pem
# MYSQL_SSL=false sólo para desactivar TLS (el servidor lo exige, no usar)
# El ERP sólo negocia TLSv1 con DHE roto; quitar cuando habiliten TLSv1.2
MYSQL_LEGACY_TLS=true
# Ruta a cloudflared si no está en PATH
CLOUDFLARED_BIN=
