DB_URI=mongodb://localhost:27017/your-database
PORT=8100
JWT_SECRET=your_secret_key
SLACK_ERROR_WEBHOOK=

# Orígenes CORS extra de producción, separados por coma
CORS_ORIGINS=

# Clave opcional para GET /api/health/mysql?key=...
HEALTH_KEY=

# MySQL ERP (Importadora Tapia) — requiere SSL/TLS
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=dbimcatabe
MYSQL_USER=crm_user
MYSQL_PASSWORD=
# CA pública del ERP: PEM crudo, PEM en base64, o ruta a archivo
MYSQL_SSL_CA=
MYSQL_SSL_CA_PATH=./certs/ca.pem
# MYSQL_SSL=false sólo para desactivar TLS (el servidor lo exige, no usar)

# Fixie SOCKS Proxy — da las IPs de salida fijas autorizadas por el ERP
FIXIE_URL=socks5://fixie:password@century.usefixie.com:1080
FIXIE_SOCKS_HOST=century.usefixie.com
FIXIE_SOCKS_PORT=1080
FIXIE_SOCKS_USER=fixie
FIXIE_SOCKS_PASS=
